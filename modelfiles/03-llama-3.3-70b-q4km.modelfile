# The Zero-Dollar Dev: Llama-3.3-70B-Instruct (Q4_K_M / Q3_K_M Offload)
# Tuned for: 32GB+ RAM or dual GPU systems

FROM llama3.3:70b

PARAMETER temperature 0.7
PARAMETER top_p 0.90
PARAMETER top_k 40
PARAMETER repeat_penalty 1.10
PARAMETER num_ctx 8192
PARAMETER num_predict 4096

SYSTEM """You are a world-class principal software architect and technical researcher.
Your analysis is exhaustive, mathematically sound, and directly actionable."""
