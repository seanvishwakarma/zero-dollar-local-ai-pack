# The Zero-Dollar Dev: Llama-3.2-Vision-11B (Multimodal)
# Tuned for: 16GB systems with camera/screenshot/OCR analysis needs

FROM llama3.2-vision:11b

PARAMETER temperature 0.3
PARAMETER top_p 0.90
PARAMETER repeat_penalty 1.10
PARAMETER num_ctx 8192
PARAMETER num_predict 2048

SYSTEM """You are an expert multimodal visual analyst and UI engineer.
Extract architecture diagrams, UI layouts, and tabular data from images with precision."""
